                      dataType="System.String"><![CDATA[using System;
using System.Collections.Generic;
using System.IO;
using System.Net;
using System.Security.Cryptography;
using System.Text;
using System.Web.Script.Serialization;
using Microsoft.SqlServer.Dts.Pipeline.Wrapper;
using Microsoft.SqlServer.Dts.Runtime.Wrapper;

[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    private const string SheetsReadOnlyScope =
        "https://www.googleapis.com/auth/spreadsheets.readonly";

    // Reads every current and future row returned by the open-ended Data!A2:O range.
    public override void CreateNewOutputRows()
    {
        try
        {
            string credentialsPath = Variables.GoogleCredentialsPath;
            string spreadsheetId = Variables.GoogleSpreadsheetId;
            string sheetRange = Variables.GoogleSheetRange;

            ServiceAccountInfo serviceAccount = ReadServiceAccount(credentialsPath);
            string accessToken = GetAccessToken(serviceAccount);
            object[][] rows = ReadGoogleSheet(accessToken, spreadsheetId, sheetRange);

            bool fireAgain = true;
            ComponentMetaData.FireInformation(
                0,
                "SRC - Google Sheet Income",
                "Rows received from Google Sheets: " + rows.Length,
                string.Empty,
                0,
                ref fireAgain);

            foreach (object[] cells in rows)
            {
                if (cells == null || IsBlankRow(cells))
                {
                    continue;
                }

                GoogleSheetOutputBuffer.AddRow();
                GoogleSheetOutputBuffer.SubmittedAt = Cell(cells, 0);
                GoogleSheetOutputBuffer.PeriodStart = Cell(cells, 1);
                GoogleSheetOutputBuffer.PeriodEnd = Cell(cells, 2);
                GoogleSheetOutputBuffer.PayDay = Cell(cells, 3);
                GoogleSheetOutputBuffer.WorkPlace = Cell(cells, 4);
                GoogleSheetOutputBuffer.EmployeeFullName = Cell(cells, 5);
                GoogleSheetOutputBuffer.GrossPayment = Cell(cells, 6);
                GoogleSheetOutputBuffer.FederalIncomeTax = Cell(cells, 7);
                GoogleSheetOutputBuffer.SocialSecurity = Cell(cells, 8);
                GoogleSheetOutputBuffer.Medicare = Cell(cells, 9);
                GoogleSheetOutputBuffer.CAStateTax = Cell(cells, 10);
                GoogleSheetOutputBuffer.CADisability = Cell(cells, 11);
                GoogleSheetOutputBuffer.NetIncome = Cell(cells, 12);
                GoogleSheetOutputBuffer.TotalTax = Cell(cells, 13);
                GoogleSheetOutputBuffer.DataValidator = Cell(cells, 14);
            }
        }
        catch (Exception ex)
        {
            bool cancel;
            ComponentMetaData.FireError(
                0,
                "SRC - Google Sheet Income",
                ex.ToString(),
                string.Empty,
                0,
                out cancel);

            throw;
        }
    }

    // Reads the service-account email, private key, and token endpoint from the JSON key.
    private static ServiceAccountInfo ReadServiceAccount(string credentialsPath)
    {
        if (string.IsNullOrWhiteSpace(credentialsPath))
        {
            throw new InvalidOperationException("GoogleCredentialsPath is empty.");
        }

        if (!File.Exists(credentialsPath))
        {
            throw new FileNotFoundException(
                "The Google service-account JSON key was not found.",
                credentialsPath);
        }

        JavaScriptSerializer serializer = CreateSerializer();
        Dictionary<string, object> json = serializer.Deserialize<Dictionary<string, object>>(
            File.ReadAllText(credentialsPath));

        return new ServiceAccountInfo
        {
            ClientEmail = RequiredString(json, "client_email"),
            PrivateKey = RequiredString(json, "private_key"),
            TokenUri = RequiredString(json, "token_uri")
        };
    }

    // Creates a short-lived OAuth access token by signing a JWT with the service-account key.
    private static string GetAccessToken(ServiceAccountInfo serviceAccount)
    {
        long issuedAt = UnixTimeSeconds(DateTime.UtcNow);

        JavaScriptSerializer serializer = CreateSerializer();
        Dictionary<string, object> claims = new Dictionary<string, object>();
        claims["iss"] = serviceAccount.ClientEmail;
        claims["scope"] = SheetsReadOnlyScope;
        claims["aud"] = serviceAccount.TokenUri;
        claims["iat"] = issuedAt;
        claims["exp"] = issuedAt + 3600;

        string encodedHeader = Base64UrlEncode(
            Encoding.UTF8.GetBytes("{\"alg\":\"RS256\",\"typ\":\"JWT\"}"));
        string encodedClaims = Base64UrlEncode(
            Encoding.UTF8.GetBytes(serializer.Serialize(claims)));
        string unsignedJwt = encodedHeader + "." + encodedClaims;

        byte[] signature;
        RSAParameters rsaParameters = ReadPkcs8PrivateKey(serviceAccount.PrivateKey);
        CspParameters cspParameters = new CspParameters(24);

        using (RSACryptoServiceProvider rsa = new RSACryptoServiceProvider(cspParameters))
        {
            rsa.PersistKeyInCsp = false;
            rsa.ImportParameters(rsaParameters);
            signature = rsa.SignData(
                Encoding.UTF8.GetBytes(unsignedJwt),
                CryptoConfig.MapNameToOID("SHA256"));
        }

        string assertion = unsignedJwt + "." + Base64UrlEncode(signature);
        string requestBody =
            "grant_type=" + Uri.EscapeDataString("urn:ietf:params:oauth:grant-type:jwt-bearer") +
            "&assertion=" + Uri.EscapeDataString(assertion);

        string responseText = SendRequest(
            serviceAccount.TokenUri,
            "POST",
            null,
            "application/x-www-form-urlencoded",
            requestBody);

        Dictionary<string, object> response = serializer.Deserialize<Dictionary<string, object>>(
            responseText);

        return RequiredString(response, "access_token");
    }

    // Calls the Google Sheets values endpoint and returns its row array.
    private static object[][] ReadGoogleSheet(
        string accessToken,
        string spreadsheetId,
        string sheetRange)
    {
        if (string.IsNullOrWhiteSpace(spreadsheetId))
        {
            throw new InvalidOperationException("GoogleSpreadsheetId is empty.");
        }

        if (string.IsNullOrWhiteSpace(sheetRange))
        {
            throw new InvalidOperationException("GoogleSheetRange is empty.");
        }

        string url =
            "https://sheets.googleapis.com/v4/spreadsheets/" +
            Uri.EscapeDataString(spreadsheetId) +
            "/values/" +
            Uri.EscapeDataString(sheetRange) +
            "?majorDimension=ROWS&valueRenderOption=FORMATTED_VALUE";

        string responseText = SendRequest(
            url,
            "GET",
            "Bearer " + accessToken,
            null,
            null);

        JavaScriptSerializer serializer = CreateSerializer();
        SheetValuesResponse response = serializer.Deserialize<SheetValuesResponse>(responseText);
        return response == null || response.values == null
            ? new object[0][]
            : response.values;
    }

    // Sends an HTTPS request and includes Google's response text in any error message.
    private static string SendRequest(
        string url,
        string method,
        string authorization,
        string contentType,
        string requestBody)
    {
        ServicePointManager.SecurityProtocol = SecurityProtocolType.Tls12;

        HttpWebRequest request = (HttpWebRequest)WebRequest.Create(url);
        request.Method = method;
        request.Accept = "application/json";
        request.Timeout = 120000;
        request.ReadWriteTimeout = 120000;

        if (!string.IsNullOrWhiteSpace(authorization))
        {
            request.Headers[HttpRequestHeader.Authorization] = authorization;
        }

        if (!string.IsNullOrEmpty(requestBody))
        {
            byte[] bodyBytes = Encoding.UTF8.GetBytes(requestBody);
            request.ContentType = contentType;
            request.ContentLength = bodyBytes.Length;

            using (Stream requestStream = request.GetRequestStream())
            {
                requestStream.Write(bodyBytes, 0, bodyBytes.Length);
            }
        }

        try
        {
            using (HttpWebResponse response = (HttpWebResponse)request.GetResponse())
            using (StreamReader reader = new StreamReader(response.GetResponseStream()))
            {
                return reader.ReadToEnd();
            }
        }
        catch (WebException ex)
        {
            string providerResponse = string.Empty;

            if (ex.Response != null)
            {
                using (Stream responseStream = ex.Response.GetResponseStream())
                using (StreamReader reader = new StreamReader(responseStream))
                {
                    providerResponse = reader.ReadToEnd();
                }
            }

            throw new InvalidOperationException(
                "Google API request failed. " + providerResponse,
                ex);
        }
    }

    private static JavaScriptSerializer CreateSerializer()
    {
        JavaScriptSerializer serializer = new JavaScriptSerializer();
        serializer.MaxJsonLength = int.MaxValue;
        serializer.RecursionLimit = 100;
        return serializer;
    }

    private static string RequiredString(Dictionary<string, object> values, string key)
    {
        object value;
        if (!values.TryGetValue(key, out value) || value == null ||
            string.IsNullOrWhiteSpace(Convert.ToString(value)))
        {
            throw new InvalidOperationException(
                "Required JSON property is missing: " + key);
        }

        return Convert.ToString(value);
    }

    private static string Cell(object[] cells, int index)
    {
        if (cells == null || index < 0 || index >= cells.Length || cells[index] == null)
        {
            return string.Empty;
        }

        return Convert.ToString(cells[index]);
    }

    private static bool IsBlankRow(object[] cells)
    {
        for (int index = 0; index < cells.Length; index++)
        {
            if (!string.IsNullOrWhiteSpace(Cell(cells, index)))
            {
                return false;
            }
        }

        return true;
    }

    private static long UnixTimeSeconds(DateTime utcDateTime)
    {
        DateTime epoch = new DateTime(1970, 1, 1, 0, 0, 0, DateTimeKind.Utc);
        return Convert.ToInt64((utcDateTime - epoch).TotalSeconds);
    }

    private static string Base64UrlEncode(byte[] value)
    {
        return Convert.ToBase64String(value)
            .TrimEnd('=')
            .Replace('+', '-')
            .Replace('/', '_');
    }

    // Converts Google's PEM PKCS#8 private key into RSA parameters using framework classes only.
    private static RSAParameters ReadPkcs8PrivateKey(string pem)
    {
        string base64 = pem
            .Replace("-----BEGIN PRIVATE KEY-----", string.Empty)
            .Replace("-----END PRIVATE KEY-----", string.Empty)
            .Replace("\r", string.Empty)
            .Replace("\n", string.Empty)
            .Trim();

        byte[] pkcs8 = Convert.FromBase64String(base64);
        DerReader privateKeyInfo = new DerReader(pkcs8).ReadSequence();

        privateKeyInfo.ReadIntegerBytes();
        privateKeyInfo.SkipElement();
        byte[] pkcs1 = privateKeyInfo.ReadOctetString();

        DerReader rsaKey = new DerReader(pkcs1).ReadSequence();
        rsaKey.ReadIntegerBytes();

        RSAParameters parameters = new RSAParameters();
        parameters.Modulus = rsaKey.ReadIntegerBytes();
        parameters.Exponent = rsaKey.ReadIntegerBytes();
        parameters.D = rsaKey.ReadIntegerBytes();
        parameters.P = rsaKey.ReadIntegerBytes();
        parameters.Q = rsaKey.ReadIntegerBytes();
        parameters.DP = rsaKey.ReadIntegerBytes();
        parameters.DQ = rsaKey.ReadIntegerBytes();
        parameters.InverseQ = rsaKey.ReadIntegerBytes();
        return parameters;
    }

    private sealed class ServiceAccountInfo
    {
        public string ClientEmail { get; set; }
        public string PrivateKey { get; set; }
        public string TokenUri { get; set; }
    }

    private sealed class SheetValuesResponse
    {
        public object[][] values { get; set; }
    }

    // Minimal ASN.1 DER reader used only for the service-account RSA private key.
    private sealed class DerReader
    {
        private readonly byte[] data;
        private int position;

        public DerReader(byte[] value)
        {
            if (value == null)
            {
                throw new ArgumentNullException("value");
            }

            data = value;
            position = 0;
        }

        public DerReader ReadSequence()
        {
            ExpectTag(0x30);
            int length = ReadLength();
            return new DerReader(ReadBytes(length));
        }

        public byte[] ReadIntegerBytes()
        {
            ExpectTag(0x02);
            int length = ReadLength();
            byte[] value = ReadBytes(length);

            int firstNonZero = 0;
            while (firstNonZero < value.Length - 1 && value[firstNonZero] == 0)
            {
                firstNonZero++;
            }

            if (firstNonZero == 0)
            {
                return value;
            }

            byte[] trimmed = new byte[value.Length - firstNonZero];
            Buffer.BlockCopy(value, firstNonZero, trimmed, 0, trimmed.Length);
            return trimmed;
        }

        public byte[] ReadOctetString()
        {
            ExpectTag(0x04);
            int length = ReadLength();
            return ReadBytes(length);
        }

        public void SkipElement()
        {
            if (position >= data.Length)
            {
                throw new InvalidDataException("Unexpected end of DER data.");
            }

            position++;
            int length = ReadLength();
            ReadBytes(length);
        }

        private void ExpectTag(byte expectedTag)
        {
            if (position >= data.Length || data[position] != expectedTag)
            {
                throw new InvalidDataException(
                    "Unexpected DER tag while reading the Google private key.");
            }

            position++;
        }

        private int ReadLength()
        {
            if (position >= data.Length)
            {
                throw new InvalidDataException("Unexpected end of DER data.");
            }

            int first = data[position++];
            if ((first & 0x80) == 0)
            {
                return first;
            }

            int lengthByteCount = first & 0x7F;
            if (lengthByteCount < 1 || lengthByteCount > 4)
            {
                throw new InvalidDataException("Unsupported DER length.");
            }

            int length = 0;
            for (int index = 0; index < lengthByteCount; index++)
            {
                if (position >= data.Length)
                {
                    throw new InvalidDataException("Unexpected end of DER data.");
                }

                length = (length << 8) | data[position++];
            }

            return length;
        }

        private byte[] ReadBytes(int length)
        {
            if (length < 0 || position + length > data.Length)
            {
                throw new InvalidDataException("Invalid DER length.");
            }

            byte[] value = new byte[length];
            Buffer.BlockCopy(data, position, value, 0, length);
            position += length;
            return value;
        }
    }
}
